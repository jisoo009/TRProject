digraph ERD {
  graph [rankdir=LR, fontname="NanumGothic", bgcolor="white", nodesep=0.55, ranksep=1.3, pad=0.4, splines=true,
         label=<<B>Save Memories ERD</B>  (제3정규형 · MySQL InnoDB)>, labelloc=t, fontsize=22];
  node [shape=plain, fontname="NanumGothic", fontsize=12];
  edge [fontname="NanumGothic", fontsize=10, color="#4a7fb5", dir=both, arrowtail=teetee, arrowhead=crowodot, penwidth=1.3];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>users</B>  <FONT POINT-SIZE="11">(회원)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="user_id"><B>PK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1e6ff" PORT="email"><B>UK</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">이메일(로그인 ID)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="password_hash">&nbsp;</TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">bcrypt 해시</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="nickname">&nbsp;</TD><TD ALIGN="LEFT">nickname</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">닉네임</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="created_at">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">TIMESTAMP</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">가입일</FONT></TD></TR></TABLE>>];
  rooms [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>rooms</B>  <FONT POINT-SIZE="11">(방)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="room_id"><B>PK</B></TD><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4f2ff" PORT="owner_user_id"><B>FK</B></TD><TD ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">방장 → users</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="room_name">&nbsp;</TD><TD ALIGN="LEFT">room_name</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">방 이름</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f1e6ff" PORT="invite_code"><B>UK</B></TD><TD ALIGN="LEFT">invite_code</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">초대 코드</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="created_at">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">TIMESTAMP</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">생성일</FONT></TD></TR></TABLE>>];
  room_members [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>room_members</B>  <FONT POINT-SIZE="11">(방 멤버)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="room_id"><B>PK,FK</B></TD><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ rooms</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="user_id"><B>PK,FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ users</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="joined_at">&nbsp;</TD><TD ALIGN="LEFT">joined_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">TIMESTAMP</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">참여일</FONT></TD></TR></TABLE>>];
  room_availabilities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>room_availabilities</B>  <FONT POINT-SIZE="11">(되는 날짜)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="room_id"><B>PK,FK</B></TD><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ room_members</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="user_id"><B>PK,FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ room_members</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="available_date"><B>PK</B></TD><TD ALIGN="LEFT">available_date</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">되는 날짜</FONT></TD></TR></TABLE>>];
  appointments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>appointments</B>  <FONT POINT-SIZE="11">(약속)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="appointment_id"><B>PK</B></TD><TD ALIGN="LEFT">appointment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4f2ff" PORT="room_id"><B>FK</B></TD><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ rooms</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4f2ff" PORT="creator_user_id"><B>FK</B></TD><TD ALIGN="LEFT">creator_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ users</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="title">&nbsp;</TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">뭐 하고 놀지</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="start_at">&nbsp;</TD><TD ALIGN="LEFT">start_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">DATETIME</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">날짜(+시간)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="place">&nbsp;</TD><TD ALIGN="LEFT">place</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">장소</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="description">&nbsp;</TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(2000)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">메모</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="created_at">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">TIMESTAMP</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">등록일</FONT></TD></TR></TABLE>>];
  photo_folders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>photo_folders</B>  <FONT POINT-SIZE="11">(사진 폴더)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="folder_id"><B>PK</B></TD><TD ALIGN="LEFT">folder_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4f2ff" PORT="room_id"><B>FK</B></TD><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ rooms</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4f2ff" PORT="creator_user_id"><B>FK</B></TD><TD ALIGN="LEFT">creator_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ users</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="name">&nbsp;</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">폴더 이름</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="folder_date">&nbsp;</TD><TD ALIGN="LEFT">folder_date</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">날짜</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="note">&nbsp;</TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(500)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">폴더 글</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="created_at">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">TIMESTAMP</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">생성일</FONT></TD></TR></TABLE>>];
  photos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>photos</B>  <FONT POINT-SIZE="11">(사진)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="photo_id"><B>PK</B></TD><TD ALIGN="LEFT">photo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4f2ff" PORT="folder_id"><B>FK</B></TD><TD ALIGN="LEFT">folder_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ photo_folders</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e4f2ff" PORT="uploader_user_id"><B>FK</B></TD><TD ALIGN="LEFT">uploader_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ users</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="file_path">&nbsp;</TD><TD ALIGN="LEFT">file_path</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">파일 경로</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="caption">&nbsp;</TD><TD ALIGN="LEFT">caption</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">VARCHAR(500)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">사진 설명</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="created_at">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">TIMESTAMP</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">업로드일</FONT></TD></TR></TABLE>>];
  photo_likes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6aa9e0"><TR><TD COLSPAN="4" BGCOLOR="#8ccbff"><B>photo_likes</B>  <FONT POINT-SIZE="11">(사진 좋아요)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="photo_id"><B>PK,FK</B></TD><TD ALIGN="LEFT">photo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ photos</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3a8" PORT="user_id"><B>PK,FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6b82">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8a97ab" POINT-SIZE="10">→ users</FONT></TD></TR></TABLE>>];
  users -> rooms [label="owner_user_id"];
  users -> room_members;
  rooms -> room_members;
  room_members -> room_availabilities;
  rooms -> appointments;
  users -> appointments;
  rooms -> photo_folders;
  users -> photo_folders;
  photo_folders -> photos;
  users -> photos;
  photos -> photo_likes;
  users -> photo_likes;
}
