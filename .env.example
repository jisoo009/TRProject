# 복사해서 .env 파일을 만든 뒤 내 환경에 맞게 고쳐 주세요.
#   (Windows)  copy .env.example .env
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=save_memories_sample

# 긴 무작위 문자열로 바꿔 주세요 (세션 암호화에 사용)
SESSION_SECRET=replace_with_a_long_random_secret

# 선택: 서버 포트 (기본 3000)
PORT=3000
